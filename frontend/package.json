    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.2",
    "vite": "7.3.6",
    "typescript": "5.9.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7"
  }
}
